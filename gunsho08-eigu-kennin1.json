 "poems": [
  {
   "seq": "1",
   "text": "きのふまてかゝる露とや野へに置秋きにけりな曉のかせ",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "夏と秋と行かふ空や明ぬらむかたへもしらぬ道芝の露",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "秋のきていくかもあらぬに荻原や曉つゆの袖になれぬる",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "なつと秋と行かふ風や吹ぬらし露ちりそむるしのゝめの道",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "秋きてはいくかもへぬに白露の置てわひしきしのゝめの空",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "きぬ〓〓の恨はしらぬ袂まて露をはつゆと秋はきにけり",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "秋きても月はまだしき袖の上に露はかりこそ有明のそら",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "秋はきぬ露は草葉に置初てゆふへしらるゝしのゝめの空",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "あけぬなりけふより秋と詠むれは萩の下葉にしのゝめの露",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "眞野の浦や曉かけて吹風にまた秋なれぬ露の萩はら",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "から衣すそのゝ露におきぬれて明ほのまよふはつ秋の空",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "露ならはかくしもいかゝ曉のむら雲あやしはつ秋の空",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "風の音におとろくのみか曉の露のをくにも秋はきにけり",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "鳥なけは立ていくのゝあさちふに露をき初る時はきにけり",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "しのゝめの風にあはれをさきたてゝこれや秋くる道芝の露",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "秋きぬとまたしら露のをきもあへす風に玉ちるのへの明ほの",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "夜をこめてさゝわくる袖に置露や秋の涙のはしめ成らん",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "秋きぬと枕につくるかねのをとにやかてもかゝる袖の露哉",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "秋は猶ゆふへの空と聞しかとたつ曉そつゆはをきける",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "秋きぬとかねもきかする篠目に朝ちるつゆもけしきと也",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "秋立てあかつき〓とのしら露やきみか三千世の數にをくらん",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "秋きぬと詠めもあへぬ風のをとにやかて露をく曉の空",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "曉はなみたや露にかさぬらん秋やは深き小のゝしのはら",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "葛の葉のうらめつらしく吹風にをけはかつちるしのゝめの露",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "秋來ぬとおもひもあへぬねさめより袖にいさよふ篠目の露",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "明やらぬともには露をすかのねの長くも〓はのなりにける哉",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "草のはら秋の日かすはあさちふの露の底より鳴立にけり",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "秋風も袖にしらるゝ明ほのに露なれそむる庭の萩原",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "秋やくる露やまかふとたとりてもま〓とはしるきしのゝめの空",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "きのふこそ夏くれたけのよをこめて秋にや露の結ひ初らん",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "秋きてもいくよかはふるしのゝめや岡へにしろき玉さゝの露",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "涼しさはかたへ過ぬる秋風に明るもしらぬ萩の下露",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "うちつけに秋の哀を白露のいつならしけん篠目の空",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "明ゆくは秋きにけりとしら露にをき分れぬる夏の面影",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "眞葛原露吹はらふしのゝめの風うらめしき秋はきにけり",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "秋はまたむすふ日數もあさちふにいつしか深きしのゝめの空",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "夏たにも月は秋なる〓みかた波ふく風の此ころのこゑ",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "宿とはん人にもかくや須磨の浦關吹こゆる秋の初かせ",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "きよみかた秋のあはれはとめてけり關守波にふしの山風",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "關もりのまたひとへなる衣てにいたくなふきそすまの秋風",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "木すゑふく風より秋の色ちりて紅葉をわくる白河の關",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "都へはしくれんころとたのめとや秋風ふきぬしら河の關",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "みちのくの衣の關に秋やたつゆふこへくれは袂すゝしも",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "山おろし紅葉をさそふ夕されは錦ふみうきしら河の關",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "人すまぬふはの關屋の板廂あれにし後はたゝ秋の風",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "さひしさはこゝにとゝめつ〓見潟關もる波に秋風そふく",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "吹すくるすまの浦風うらむなよ秋のけしきはとゝめ置とも",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "都出てかさなる山の秋風にむかしのあとをしら河の關",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "風の音やみにしむはかり聞ゆらん心つくしのもしの關もり",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "春やまたあふ坂こえん秋風にけふ立かへるしら川の關",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "〓見潟せきもる浪の秋の聲これや都の荻の上かせ",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "白河の關の秋風立かへりいつふるさとに雪のゆふくれ",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "春のくる道とそきゝし相坂の關にも秋の風は吹けり",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "時しもあれ秋の旅ねをすまの關身にしむ風のかへる白波",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "霞わけ都立けんいにしへのあとおもほゆるしら河の關",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "誰かまたふしの秋風みにしみて〓見か關を月にこゆらむ",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "やとりつる衣の關をけさ立は袂すゝしき秋かせそふく",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "秋風は衣の關にたちにけり月日もしらぬひなの長路は",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "浦かよふ秋風さひしすまの關吹こす浪のをとにつけても",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "すゝか山關こえならす道すからみねの木のはに秋風そ吹",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "相坂やいまは夜寒の山風をわらやのとこに誰しのふらん",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "あふ坂の山吹こゆる秋風も聲をとゝむる關のすきむら",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "秋風のふきくるかたやそれならん都の空もしら河のせき",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "さひしさをたれにかたらむ秋風にひとり關もるあしからの山",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "しら河の關の秋風立ぬなり都のかすみ月日へたてゝ",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "春霞ともに立けん旅人のい□し風ふくしら河の關",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "むかしたれわひて住けん逢坂の關の秋風袂すゝしも",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "秋はなをすまの關路の夕まくれ浦吹風の浪の音まて",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "かへるさの色はこすゑに契りをかし秋風立ぬ逢坂の關",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "人こそあれ風は過ゆく浦路哉〓見か關の秋の夕くれ",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "音羽山峯の木の葉やかはるらむ關路すゝしく秋風そふく",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "あはれ春かすみしものを相坂やせき路の杉に秋かせそ吹",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "夜をかさね月に朝たつ旅衣きつゝなれゆく小男鹿の聲",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "野への鹿そふるなくねは我ひとりいてし都も月は見るとも",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "わするなよかりねに月をみやきのゝ枕そ近きさをしかの聲",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "草むすふ露の枕に袖しきて月にしかなく小夜のなか山",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "よをこめてたつへきのへの名殘こそ鹿の音なから有明の月",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "都人月はへたてぬおもかけにならはぬものはさをしかの聲",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "月みてはなくさみぬへき旅ねにも猶袖ぬらすさをしかのこゑ",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "月影はきつゝもなれぬ旅衣すそのゝはらかさをしかの聲",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "をかやふくたひねの床にもりくるは月や友なふさを鹿の聲",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "草枕かり庵てらす月のみかつまよふしかの聲もわりなし",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "男鹿なくは山のしけり分くれて月に友とふ手枕の露",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "月のすむさゝ浪山に一夜ねてしかのなくれを枕にそきく",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "月寒み野への鹿の音身にしみてころもかたしき旅ねをそする",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "まはらなるしはのかり庵に月もりて枕に近きさを鹿の聲",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "秋の空なをいひしらぬ旅ね哉よわたる月にさをしかの聲",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "草まくらなみたもよほす鹿の音や今宵の月もくもるなるらん",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "庵むすふ小のゝ篠原月さひてたへぬあまりに鹿の音そする",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "草枕哀を袖にさき立て月にやとかれさほしかのこゑ",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "月影にいせのはま荻敷そめし昔もかくや鹿の鳴らん",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "篠原や旅ねの月にふしわひて幾夜か鹿の聲恨らむ",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "露むすふ旅れの床にもる月を袖にうらむるさをしかの聲",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "飛鳥のあすかの宮のきり〓〓す月やむかしの秋になくえ",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "よもすから野への枕にすむ月のあはれをそふるさを鹿のこゑ",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "草枕月はくもらめ袖の雨やすそのによはるさを鹿の聲",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "月は猶都もすみき草枕かりにもきゝし鹿の聲かは",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "鹿のねをすそのゝ原に先てゝ山路を送る有明の月",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "月のすむあまの河原に宿かれはかたのゝ鹿も哀そふ也",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "月をみて都をいてしあらましにおもひしまゝの小男鹿の聲",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "おもひしりぬのへはすみかの鹿のねに草の枕の有明の月",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "旅の空我とゝもなる月影に嵐もしかの聲送るなり",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "草まくらつけのゝ野への月影にむかしおほゆるさをしかの聲",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "今宵たれ秋の野山に旅ねして月をなかめて鹿か聞蘭",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "105",
   "text": "松かねのまくらに鹿の聲はして木の間の月を袖に見るかな",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "106",
   "text": "したひゆく我をも友に哀とや鹿なくみねに月殘るらん",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "107",
   "text": "いかにせん月はくまなき旅の庵におほろに鹿の聲を聞かする",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "108",
   "text": "高圓の尾上の宮の秋萩をたれきてみよと松むしの聲",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "109",
   "text": "あれぬとて鳴かまかきのきり〓〓すをのれ淋しき蓬生の宿",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "110",
   "text": "住なれし宿はむかしのあさち原誰としりてか松虫の聲",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "111",
   "text": "虫のねそかはらぬ秋の恨にてすみすてゝける淺茅生のさと",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "112",
   "text": "むかしへをしのふる里の淺茅生に今もや人を松虫の聲",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "113",
   "text": "草枕鹿のねそはぬ月にたになくさめかねしさらしなの山",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "114",
   "text": "船とむるあかしの月の有明に浦より遠のさほしかのこゑ",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "115",
   "text": "故里の秋の夢ちの關もりはみかきかはらの松虫のこゑ",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "116",
   "text": "あれぬなりたか住すてし宿なれやまかきの野への虫の聲こゑ",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "117",
   "text": "たれきけとあれたる宿の蓬生に聲ふりたてゝ鈴むしの聲",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "118",
   "text": "いく夜へて虫のねしけくあれぬらんむくらの宿の秋のゆふ暮",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "119",
   "text": "故〓の庭にてしりぬ虫のねをおもはん宿は草にまかせて",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "120",
   "text": "秋をへて幾夜もしらぬ故里に昔おほゆる松虫の聲",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "121",
   "text": "習はねはまたしらねともこれやさは怪しかるへき詠め成らん",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "122",
   "text": "行末をおもふもかなしやかてさは淚にくもる秋のみかつき",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "123",
   "text": "けふこそはほのかに人をみしま江の蘆の浦はのうち萎れつゝ",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "124",
   "text": "今こんと契るともなき故〓に長き夜すから松虫のこゑ",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "125",
   "text": "我戀はけふ初時雨もるやまにかはる下葉の秋のひとしほ",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "126",
   "text": "ならはすよ秋なれはとてをくか露かたしく袖の打しめるまて",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "127",
   "text": "くちにけるまかきの跡に音つれて獨ときはの松虫の聲",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "128",
   "text": "宿はあれて庭はのへなる故〓にあるしとなりて虫の侘らん",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "129",
   "text": "故〓は野原の庭のものとみて猶心ある松むしのこゑ",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "130",
   "text": "すまの蜑のもしほの烟たちまちにむせふ思ひを問人のなき",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "131",
   "text": "けふよりや人に心をおきつ浪かけてもしらぬ袖の浦風",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "132",
   "text": "故〓の野らと成ぬる籬まて猶ぬし有と松虫のこゑ",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "133",
   "text": "秋の夜は猶長岡の故〓に昔をしのふ鈴むしのこゑ",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "134",
   "text": "故〓は庵のむくらのほとよりも猶しけみなる虫の聲哉",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "135",
   "text": "故〓の庵をは野へとなしはてゝ虫の音のみやあるしなるらん",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "136",
   "text": "むかしたにまかきものらと成し跡にたれまつ虫の今も鳴らん",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "137",
   "text": "我ひとりあるし顔にて故〓に人まつむしの鳴明すらん",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "138",
   "text": "はかなしや誰に契りを深草の野となる里に松虫の聲",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "139",
   "text": "昔わかすみしわたりを尋ぬれはこたへ顔なるきり〓〓す哉",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "140",
   "text": "故〓のかきほはやかてむしのれの聲々しけき野へにそ有ける",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "141",
   "text": "つたへくる人もよりこめ故〓にこゑの絕せぬきり〓〓すかな",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "142",
   "text": "物おもへは涙のいろはかはるかと戀になれたる人にとはゝや",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "143",
   "text": "しるへとて風のたよりをたのめとも猶跡もなさ波の上かな",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "144",
   "text": "またしらぬ詠めは今宵いつかまたものや思ふと人にとはれん",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "145",
   "text": "きのふまてよそに詠めし浦人のしほたれ衣袖もほしあへす",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "146",
   "text": "我戀はあさかの沼の花かつみかつ〓〓袖のしほれそめぬる",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "147",
   "text": "しらさりし戀に淚をかけそめてならはぬ袖をしほりそへぬる",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "148",
   "text": "獨ぬる〓とはえならぬ物なれやあはせぬ胸をこかし初ぬる",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "149",
   "text": "さゝれ石のなかの思ひをうち出てゝ仄かにけふそしらせ初ぬる",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "150",
   "text": "いつしかと深きためしは紅の初花そめの一しほをみよ",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "151",
   "text": "しらせてもかひなかりけり何せんに思ひ返さて色に出にけん",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "152",
   "text": "きて見れは思ひし宿のかたみかと庭のよもきに虫の聲のみ",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "153",
   "text": "住すてゝ人めかれにし淺茅生にたかならはせる松むしの聲",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "154",
   "text": "あれはつる宿のあさちにふりせぬはむくらの下の鈴虫の聲",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "155",
   "text": "さりとてもたのましものを故〓にこれやならひの松虫の聲",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "156",
   "text": "たかうへし一むらすゝき道たえて虫の音しけきのへと成らん",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "157",
   "text": "かり人はのへとなるはかり住すてゝふりゆく里のすゝ虫の聲",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "158",
   "text": "跡もなき蓬か杣の庭の面にむかしにならふ松虫の聲",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "159",
   "text": "志賀の宮昔なからのきり〓〓す誰手枕の跡おもふらん",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "160",
   "text": "いにしへの高津の宮の跡ふりて虫の音のみそ秋を忘れぬ",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "161",
   "text": "あれにけり昔のかへのきり〓〓すよもきか柚に聲そ殘れる",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "162",
   "text": "覺束なはつとやたしのかたかへりかりはのをのゝ戀の行末",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "163",
   "text": "いつよりか思ひ合せんよひ〓〓のいめに見えしは我そゝれ共",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "164",
   "text": "思ひかねけふふみそむるあ[〓]いつれの誰かあふ坂の關",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "165",
   "text": "ほのかにもいかてしらせん逢夜まてうかひにくたす篝火の影",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "166",
   "text": "身に包むかひもあらしをよしさらは漏してを見ん人の心も",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "167",
   "text": "戀くさやいつ花そめの袖の露いかになれてか色かはるらん",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "168",
   "text": "きのふまてかくやは袖のしほれにしあやしや露の處せきまて",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "169",
   "text": "しらさりし歎きやこれと思ふよりうちぬる宵のたゝならぬ哉",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "170",
   "text": "人しれぬ思ひといふやこれならん我みよりこそ恨み初ぬれ",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "171",
   "text": "今日よりは烟をよそに思ふかは戀せしすまのあまのもしほひ",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "172",
   "text": "せかしたゝたえぬおもひの涙川いつしか袖は色かはるとも",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "173",
   "text": "きえわたる雪まにみゆる初草のけふよりもえて物やおもはん",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "174",
   "text": "思ひあまりけふふみそむる丸木橋わたる計の契りとも哉",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "175",
   "text": "戀草の種まきそむる程もなくいつしか袖にむすふ露哉",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "176",
   "text": "いかにせんおもひ立てもから衣なれぬにあらふ袖の玉水",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "177",
   "text": "見そめつるけさよりしける戀草にいつしか深き袖の白露",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "178",
   "text": "人しれぬ涙はけふそ初しくれいつしか袖の色に出にける",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "179",
   "text": "またしらぬ戀路とおもふやすらひに中〓〓まよふ我心かな",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "180",
   "text": "今こんといひしはかりを賴みにていく長月をすくしきぬらん",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "181",
   "text": "宿りせぬくらふの山は夢路にてまとふ思ひの年そふりぬる",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "182",
   "text": "年月はむなしき空に移りきてふるきなかめになれぬ佛",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "183",
   "text": "いくかへり涙しくるゝ秋をへてたえぬなけさの色を染らん",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "184",
   "text": "夏引の手ひきの糸の年へてもたえぬ思ひにむすほゝれつゝ",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "185",
   "text": "まちわひて三年も過る床の上に猶かはらぬは淚なりけり",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "186",
   "text": "住吉の千木のかたそきあはすして久しきためし我をよにみよ",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "187",
   "text": "逢〓とを今や〓〓とまつ山のまつにてのみや世をはつくさむ",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "188",
   "text": "昔よりいもゆへ袖をしほりつゝみつはくむにもやゝ勝りけり",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "189",
   "text": "いつまてとつらからさりし昔より休むまもなき我心哉",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "190",
   "text": "]契りしものをいはのまつつる巢くふまて成にける哉",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "191",
   "text": "戀しなて年も遙にみくまのゝ浦のはまゆふ重ねきにけり",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "192",
   "text": "しるらめやいつより袖のぬれそめてけふ徒らに朽はてぬらん",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "193",
   "text": "百夜ともしちのまろねは賴めけりいつ我戀の限りなるらん",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "194",
   "text": "思ひきやわかの浦にてみし人に老の浪まて袖ぬれんとは",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "195",
   "text": "賴めをけ今いくとせをまてとたに命をかけんその言のはに",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "196",
   "text": "つゝいつの井筒にかけし昔よりみつはくむまて思ふ心を",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "197",
   "text": "年をへて涙のみをに沈めともくちぬは戀の心なりけり",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "198",
   "text": "月影のたくひともなき我戀もつもれは人の老となりけり",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "199",
   "text": "人心うきたのもりに引しめの幾年かけて朽はてぬらん",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "200",
   "text": "年ふれはたのめ[_]たえてむなしき庭に荻の上かせ",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "201",
   "text": "恨みてもかゝるおもひに[〓]つれなしとやは人はいふへき",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "202",
   "text": "くらへこしふりわけ髪のなからへてもといひそめし[",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "203",
   "text": "住吉のきしの姫松それならて幾世か袖に浪をかくらん",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "204",
   "text": "いかゝせんとしふる戀を[〓]やそせの波の袖に[",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "205",
   "text": "いくとせも[〓]さはさらすとて數ならぬとは思ひやはなき",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "206",
   "text": "涙のみふるの神杉いく世へてつらきしるしの猶殘るらん",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
